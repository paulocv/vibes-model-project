--- MODEL PARAMETERS
Baseline transmission probabilities of each layer – R = 2.5
> beta_c = 1.014227
> beta_h = 3.173878
> beta_s = 1.313141
> beta_w = 1.032744

--- BEHAVIORAL RESPONSES
> rnd_ptest_probab = 0.00  # 0.00415 # Probability of trying a positive test at random at each STEP.
> so_ptest_probab = 0.00   # # Probability of trying a positive test after onset of symptoms
-
> ct_probab = 0.00  # Probability of engaging in contact tracing
> ct_comply_probab_h = 1.00  # Contact tracing compliance (and positive testing): household
> ct_comply_probab_s = 0.95  # Contact tracing compliance (and positive testing): schools
> ct_comply_probab_w = 0.95  # Contact tracing compliance (and positive testing): workplace
> ct_comply_probab_c = 0.25  # Contact tracing compliance (and positive testing): community
-
> quarant_probab = 0.00  # If a node engages self isolation, this is the probability that its household members will also do it.
-
> skip_ptest_at_ct = true  # If true, contact tracing targets engage behavior regardless of positive-testing.
-
> ptest_delay = 1.0  # Delay (in days) between a ptest trigger and the actual ptest
> ptest_res_delay = 0.0  # Delay (in days) between a ptest execution and its effect (e.g. delay for results to be shown)
> ct_delay = 0.0  # Delay between a contact tracing trigger and its execution
-
# > behav_path = behav_change/metrics_paper/00d-07d.csv
> behav_path = behav_change/metrics_paper/00d-14d.csv
# > behav_path = behav_change/metrics_paper/00d-21d.csv


--- INDIVIDUAL TRANSMISSIBILITY
> use_transm_gamma = true
> transm_gamma_shape = 0.242  # Transm. heterogeneity: param k (a) (power-law rise)
> transm_gamma_scale = 4.132231    # Transm. heterogeneity: param theta (b) (exponential decay)
> sympt_transm_coef = 1.0  # Symptomatic nodes will multiply their own transmissibility value by this extra factor.

--- SIMULATION PARAMETERS
> max_steps = 6000
> step_dt = 0.25
> rnd_seed = 01001  # Set to 0 for time-based

> init_mode = num   # num, node, frac, nodeset
> init_data = 30

--- POPULATION PARAMETERS
> population_path = networks/res_network/persons_indx_Indiana.txt
> age_data_path = age_data/age_table_01_x1p5.csv

--- TRANSMISSIBILITY CURVES
> transm_curves_sympt_path = transmissibility/viral-dynamics/symptomatic_v01.csv
> transm_curves_asymp_path = transmissibility/viral-dynamics/asymptomatic_v01.csv
> normalize_transm_curves = true

--- OUTPUT TO FILES
> export_r_and_tg_series = true
> export_event_logs = false
> export_status_series = true
> export_tg_histogram = true
> export_node_event_data = true
> export_symptom_series = false
> export_presence_series = true
> export_sec_attack_rate = false

--- EXECUTIONS/RUNS
> num_execs = 1
> exec_prefix = run
> exec_start_index = 0

--- MISC
> merge_u_into_s = true  # Whether universities must be included as schools too.
> simulate_r_index = false
